# Dependencies
node_modules/
.pnp/
.pnp.js
.yarn/

# Build output
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
.turbo/
.cache/
# TypeScript incremental-build cache. Generated, machine-specific, and
# rewritten by every `tsc`/`next build` — tracking it produced a permanently
# dirty working tree and pointless merge conflicts (untracked 2026-08-14).
*.tsbuildinfo

# Environment & secrets
.env
.env.*
!.env.example
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & coverage
coverage/
.nyc_output/

# Editor & OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
.DS_Store
Thumbs.db
desktop.ini

# Temporary
tmp/
temp/
*.tmp

# Framework caches (to be refined once stack is chosen)
.vercel/
.output/

# D-050 hero-face pipeline — personal source photo is never committed;
# the derived apps/web/public/hero-face.json IS. Keep the README tracked
# so the drop location stays discoverable.
apps/web/scripts/assets/*
!apps/web/scripts/assets/README.md

# D-056 gallery pipeline — personal source photos (read by
# apps/web/scripts/process-gallery.mjs) are never committed; the derived,
# EXIF-stripped output in apps/web/public/gallery/ IS. Keep the README
# tracked so the drop location stays discoverable.
photos/*
!photos/README.md

# Cloudflare credential reference — never committed (secrets live in .env.local
# and the Render env store). gitignored so `git add .` can never catch it.
cloudflare.txt

.vercel
.env*
